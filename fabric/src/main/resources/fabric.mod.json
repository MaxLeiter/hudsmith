{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${homepage}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "icon": "assets/hudsmith/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.maxleiter.hudsmith.fabric.HudsmithFabricClient"],
    "modmenu": ["com.maxleiter.hudsmith.fabric.HudsmithModMenu"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "vellum": ">=${vellum_version}",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
